{
  "name": "color-flood",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "gen": "node --experimental-strip-types --no-warnings src/cli.ts",
    "build": "tsc -p tsconfig.build.json",
    "serve": "node scripts/serve.js",
    "fonts": "node scripts/fetch-fonts.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "typescript": "^5.8.0",
    "vitest": "^2.1.0"
  }
}
